# Copy to .env before starting the project on a server:
#   cp .env.example .env && chmod 600 .env && nano .env
# Without a .env file the local demo defaults in compose.yaml are used.

# Web application: 0.0.0.0 and 80 make it reachable at http://SERVER_IP/
WEB_BIND=0.0.0.0
WEB_PORT=80

# PostgreSQL password (never open port 5432/5433 to the Internet)
DB_PASSWORD=change-me-database-password

# Initial passwords of the two web accounts (used only when the account
# store is created for the first time)
ADMIN_PASSWORD=change-me-admin-password
DESK_PASSWORD=change-me-desk-password

# Set to 1 only when the site is served over HTTPS
HTTPS_COOKIE=0
